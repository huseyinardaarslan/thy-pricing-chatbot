# Azure OpenAI (agent'i canli calistirmak icin ZORUNLU)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://mavi-resource.openai.azure.com/openai/v1/
AGENT_MODEL=gpt-5.4-mini

# Gercek THY canli MCP (OAuth girisi: python -m app.agent.thy_auth)
THY_MCP_URL=https://mcp.turkishtechlab.com/mcp

# Kurumsal ses-metin (opsiyonel). Bos birakilirsa tarayici yerlesigi kullanilir.
# Azure'da transcription modeli deploy edildikten sonra doldurun:
# SPEECH_MODEL=gpt-4o-transcribe
